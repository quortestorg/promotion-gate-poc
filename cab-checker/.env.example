# GitHub App (Settings > Developer settings > GitHub Apps > cab-checker)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=./cab-checker.private-key.pem
GITHUB_WEBHOOK_SECRET=

# Azure DevOps
ADO_ORG_URL=https://dev.azure.com/<your-org>
ADO_PAT=

# Who may approve. Emails as they appear in ADO (uniqueName), comma-separated.
OWNER_APPROVERS=
SECURITY_APPROVERS=

# Optional
ENVIRONMENT_NAME=prod
POLL_SECONDS=60
PORT=8080
